{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "RenzBase",
  "version": "0.2.0",
  "identifier": "com.renzbase.app",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "RenzBase",
        "width": 1180,
        "height": 760,
        "minWidth": 940,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "theme": "Dark",
        "backgroundColor": "#0f0f10",
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": false
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "category": "DeveloperTool",
    "shortDescription": "RenzBase Roblox executor",
    "longDescription": "Single-executable Roblox script executor: window, injector and payload in one file."
  }
}
